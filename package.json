{
  "name": "systems-sketched",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ss/system-design",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm --filter @ss/tools validate",
    "lessons": "pnpm --filter @ss/tools validate --write",
    "knip": "knip",
    "dev:finance": "turbo run dev --filter=@ss/finance",
    "e2e": "pnpm --filter \"./apps/*\" e2e",
    "dev:forex": "turbo run dev --filter=@ss/forex"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.48.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
